# POC edge stack configuration. Copy to .env (done automatically by `make up`)
# and change every *_change_me value. NEVER commit .env.

# --- PostgreSQL / TimescaleDB ---
# The app/migrate DSN is assembled in docker-compose.yml from these values —
# the password lives only here.
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_pass_change_me
POSTGRES_DB=iot

# --- Redis ---
REDIS_ADDR=redis:6379

# --- EMQX / MQTT ---
MQTT_BROKER_URL=tcp://emqx:1883
# Must match infra/edge/emqx/users-bootstrap.csv (copied from .example on
# `make up`). EMQX imports the CSV only on FIRST start (fresh volume) — to
# change passwords later, use Dashboard > Access Control > Authentication.
MQTT_USERNAME=app
MQTT_PASSWORD=app_pass_change_me
MQTT_CLIENT_ID_PREFIX=iot-app
# Interface Agreement topic prefix v1/{tenant}/{park} — fixed in POC
MQTT_TOPIC_PREFIX=v1/demo/park01
# EMQX dashboard (http://localhost:18083, user admin)
EMQX_DASHBOARD_PASSWORD=emqx_dash_change_me
# Erlang distribution cookie (single node POC; still keep it out of git)
EMQX_NODE_COOKIE=emqx_cookie_change_me

# --- Grafana (ops dashboards, http://localhost:3000, user admin) ---
GRAFANA_ADMIN_PASSWORD=grafana_change_me
# Read-only PG role for the Grafana datasource (created on first PG init;
# changing it later requires ALTER ROLE in psql)
GRAFANA_RO_PASSWORD=grafana_ro_change_me

# --- App ---
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_S=10
