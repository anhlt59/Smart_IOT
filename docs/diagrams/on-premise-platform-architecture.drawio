        </mxCell>

        <mxCell id="fw1" value="FORTIGATE 80F — NGFW · deny-by-default · IPS · policy DMZ ↔ Server Room (một thiết bị vật lý phân đoạn mọi VLAN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8f3b36;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
