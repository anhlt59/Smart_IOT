        </mxCell>
        <mxCell id="dmz1" value="EMQX Bridge — uplink MQTT mTLS · store-and-forward · cờ backfill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="215" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dmz2" value="MediaMTX Relay — video on-demand (WebRTC/HLS), giới hạn stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="215" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dmz3" value="Sync Uplink Service — backup nightly → Object Storage · metrics/logs remote_write · snapshot sự kiện (pre-signed URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
