        <mxCell id="title" value="ON-PREMISE PLATFORM ARCHITECTURE — DOCKER COMPOSE (01 KHU CÔNG NGHIỆP · Production · KHÔNG Kubernetes/K3s)" style="text;html=1;align=center;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="12" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cloud" value="VNPT CLOUD PLATFORM (ngoài phạm vi sơ đồ) — kết nối: VNPT MPLS/L3VPN primary + Internet IPsec backup (SD-WAN failover trên FortiGate)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="700" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dmz" value="Z3.5 — DMZ (VLAN riêng trên FortiGate) — cửa duy nhất site ↔ cloud · VPN site-to-site terminate tại FortiGate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
