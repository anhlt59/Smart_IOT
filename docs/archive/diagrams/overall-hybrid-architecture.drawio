        </mxCell>

        <mxCell id="conn" value="HYBRID CONNECTIVITY — không mở inbound từ Internet vào site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
